@then("в базе данных создается запись аналитики:")
def then_analytics_record_created(user_context, datatable):
    """Проверка создания записи аналитики"""
    expected_metrics = {row["metric"]: row["value"] for row in datatable}

    # Симуляция проверки записи в БД
    analytics_record = {
        "user_id": user_context.user_id,
        "session_start": datetime.now().isoformat(),
        "selected_symptom": "tired",
        "delivery_method": "telegram",
        "subscribed": True,
    }

    for metric, expected_value in expected_metrics.items():
        if metric in analytics_record:
            assert str(analytics_record[metric]) == expected_value or expected_value.startswith("<"), \
                f"Метрика {metric}: ожидалось {expected_value}, получено {analytics_record[metric]}"
