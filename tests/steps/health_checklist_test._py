@then(parse("бот сохраняет в базе данных флаг подписки user_id={user_id:d} subscribed={subscribed}"))
def then_bot_saves_subscription(user_context, user_id: int, subscribed: str):
    """Проверка сохранения в БД (мок)"""
    subscribed_bool = subscribed.lower() == "true"
    user_context.db_records.append({
        "user_id": user_id,
        "subscribed": subscribed_bool,
        "timestamp": datetime.now()
    })


@then("бот отправляет уведомление администратору о новой подписке")
