import asyncio
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Any

from pytest_bdd import given, scenarios, then, when
from pytest_bdd.parsers import parse

# Импортируем состояния из вашего обработчика (предполагаемая структура)
try:
    from src.handlers.health_checklist import HealthChecklistStates, create_health_checklist_router
except ImportError:
    # Fallback для тестирования без реального кода
    from enum import Enum


    class HealthChecklistStates(str, Enum):
        waiting_for_symptom = "waiting_for_symptom"
        waiting_for_delivery_choice = "waiting_for_delivery_choice"
        waiting_for_email = "waiting_for_email"
        waiting_for_subscription = "waiting_for_subscription"


    def create_health_checklist_router():
        from aiogram import Router
        return Router()

# Загружаем сценарии
scenarios("features/health_checklist.feature", features_base_dir=str(Path(__file__).parent.parent))


# ========== Вспомогательные классы и fixtures ==========

@dataclass
class HealthChecklistContext:
    """Расширенный контекст тестового пользователя для лид-магнита"""
    user_id: int
    chat_id: int
    username: str = "test_user"
    messages_sent: list[dict[str, Any]] = field(default_factory=list)
    documents_sent: list[dict[str, Any]] = field(default_factory=list)
    callbacks_answered: list[str] = field(default_factory=list)
    last_message_id: int = 0
    last_callback_id: int = 0
    bot: Any = None
    db_records: list[dict] = field(default_factory=list)  # Симуляция записей в БД


def run_async(coro):
    """Утилита для запуска корутин в синхронном контексте step-функций"""
    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            return loop.run_until_complete(coro)
        return asyncio.run(coro)
    except RuntimeError:
        return asyncio.run(coro)


# ========== Given шаги ==========

@given(parse("пользователь с ID {user_id:d} в личном чате с ботом"), target_fixture="user_context")
def given_user_health_context(user_id: int) -> HealthChecklistContext:
    """Создание контекста пользователя для тестов лид-магнита"""
    return HealthChecklistContext(user_id=user_id, chat_id=user_id)




@given(parse('пользователь находится в состоянии ожидания выбора способа доставки для симптома "{symptom}"'))
def given_user_waiting_delivery(fsm_context, symptom: str):
    """Установка состояния ожидания выбора доставки"""

    async def _impl():
        await fsm_context.set_state(HealthChecklistStates.waiting_for_delivery_choice)
        await fsm_context.update_data(selected_symptom=symptom, checklist_title=f"Чеклист: {symptom}")

    run_async(_impl())


@given(parse("пользователь находится в состоянии ожидания email для симптома \"{symptom}\""))
def given_user_waiting_email(fsm_context, symptom: str):
    """Установка состояния ожидания ввода email"""

    async def _impl():
        await fsm_context.set_state(HealthChecklistStates.waiting_for_email)
        await fsm_context.update_data(selected_symptom=symptom, delivery_method="email")

    run_async(_impl())


@given("пользователь получил чеклист и находится в состоянии ожидания решения о подписке")
def given_user_received_checklist(fsm_context):
    """Установка состояния после получения чеклиста"""

    async def _impl():
        await fsm_context.set_state(HealthChecklistStates.waiting_for_subscription)
        await fsm_context.update_data(
            checklist_received=True,
            selected_symptom="tired",
            delivery_method="telegram"
        )

    run_async(_impl())


@given(parse("пользователь находится в состоянии \"{state}\""))
def given_user_in_specific_state(fsm_context, state: str):
    """Универсальная установка состояния по строке"""
    state_map = {
        "waiting_for_symptom": HealthChecklistStates.waiting_for_symptom,
        "waiting_for_delivery_choice": HealthChecklistStates.waiting_for_delivery_choice,
        "waiting_for_email": HealthChecklistStates.waiting_for_email,
        "waiting_for_subscription": HealthChecklistStates.waiting_for_subscription,
    }

    async def _impl():
        target_state = state_map.get(state)
        if target_state:
            await fsm_context.set_state(target_state)
        else:
            raise ValueError(f"Unknown state: {state}")

    run_async(_impl())


# ========== When шаги ==========



@when(parse('пользователь выбирает проблему "{symptom}"'))
def when_user_selects_symptom(dispatcher, bot, user_context, symptom: str):
    """Выбор симптома (через callback или текст)"""
    from tests.steps.conftest import create_message, process_update

    async def _impl():
        # Симулируем callback query или текстовое сообщение
        msg = create_message(user_context, text=f"symptom:{symptom}")
        await process_update(dispatcher, bot, msg)

    run_async(_impl())


@when(parse('пользователь выбирает кнопку "{button_id}"'))
def when_user_selects_button(dispatcher, bot, user_context, button_id: str):
    """Выбор кнопки с определенным ID"""
    from tests.steps.conftest import create_message, process_update

    async def _impl():
        # Симулируем callback data
        msg = create_message(user_context, text=button_id)
        await process_update(dispatcher, bot, msg)

    run_async(_impl())


@when(parse('пользователь вводит email "{email}"'))
def when_user_enters_email(dispatcher, bot, user_context, email: str):
    """Ввод адреса электронной почты"""
    from tests.steps.conftest import create_message, process_update

    async def _impl():
        msg = create_message(user_context, text=email)
        await process_update(dispatcher, bot, msg)

    run_async(_impl())


@when(parse('пользователь отправляет команду "{command}"'))
def when_user_sends_command(dispatcher, bot, user_context, command: str):
    """Отправка произвольной команды"""
    from tests.steps.conftest import create_message, process_update

    async def _impl():
        cmd = f"/{command}" if not command.startswith("/") else command
        msg = create_message(user_context, text=cmd)
        await process_update(dispatcher, bot, msg)

    run_async(_impl())


# ========== Then шаги ==========



@then("бот отображает кнопки с проблемами:", target_fixture="symptom_buttons")
def then_bot_shows_symptom_buttons(bot, user_context, datatable):
    """Проверка кнопок выбора проблемы с использованием DataTable"""
    last_msg = user_context.get_last_message()
    markup = last_msg.get("reply_markup", {})

    expected_buttons = {row["button_id"]: row["button_text"] for row in datatable}
    actual_buttons = {}

    # Извлекаем кнопки из inline keyboard
    if "inline_keyboard" in markup:
        for row in markup["inline_keyboard"]:
            for btn in row:
                if "callback_data" in btn:
                    actual_buttons[btn["callback_data"]] = btn.get("text", "")

    for btn_id, btn_text in expected_buttons.items():
        assert btn_id in actual_buttons, f"Кнопка {btn_id} не найдена в {actual_buttons}"
        assert btn_text in actual_buttons[btn_id], f"Текст кнопки {btn_id} не совпадает"

    return expected_buttons


@then(parse('бот предлагает скачать документ "{document_title}"'))
def then_bot_offers_document(bot, user_context, document_title: str):
    """Проверка предложения скачать документ"""
    last_msg = user_context.get_last_message()
    assert document_title in last_msg["text"], f"Заголовок документа '{document_title}' не найден"


@then("бот отображает кнопки отправки:")
def then_bot_shows_delivery_buttons(bot, user_context, datatable):
    """Проверка кнопок выбора способа доставки"""
    last_msg = user_context.get_last_message()
    markup = last_msg.get("reply_markup", {})

    expected = {row["button_id"]: row["button_text"] for row in datatable}
    actual = {}

    if "inline_keyboard" in markup:
        for row in markup["inline_keyboard"]:
            for btn in row:
                if "callback_data" in btn:
                    actual[btn["callback_data"]] = btn.get("text", "")

    for btn_id, btn_text in expected.items():
        assert btn_id in actual, f"Кнопка доставки {btn_id} не найдена"


@then(parse('бот отправляет PDF документ "{filename}"'))
def then_bot_sends_pdf(bot, user_context, filename: str):
    """Проверка отправки PDF документа"""
    assert len(user_context.documents_sent) > 0, "Документы не отправлены"
    last_doc = user_context.documents_sent[-1]
    assert filename in last_doc.get("filename", ""), f"Ожидался файл {filename}"


@then(parse("документ имеет размер менее {max_size:d} МБ"))
def then_document_size_check(bot, user_context, max_size: int, checklist_db: dict):
    """Проверка размера документа"""
    # Используем мок данные из фикстуры checklist_db
    last_doc = user_context.documents_sent[-1]
    filename = last_doc.get("filename", "")

    for symptom, data in checklist_db.items():
        if data["filename"] == filename:
            assert data["size_mb"] < max_size, f"Размер документа {data['size_mb']}MB превышает {max_size}MB"


@then(parse('бот выводит сообщение с предложением перейти на канал:\n"""\n{expected_message}\n"""'))
def then_bot_shows_channel_offer(bot, user_context, expected_message: str):
    """Проверка многострочного сообщения с предложением подписки"""
    last_msg = user_context.get_last_message()
    actual_text = last_msg["text"].strip()
    expected_clean = expected_message.strip()

    # Проверяем ключевые части сообщения
    assert "канал" in actual_text.lower() or "подпис" in actual_text.lower(), \
        f"Сообщение не содержит предложения о подписке: {actual_text}"
    assert "@" in actual_text, f"В сообщении нет упоминания канала: {actual_text}"


@then("бот отображает кнопки:")
def then_bot_shows_generic_buttons(bot, user_context, datatable):
    """Универсальная проверка кнопок"""
    last_msg = user_context.get_last_message()
    markup = last_msg.get("reply_markup", {})

    expected = {row["button_id"]: row["button_text"] for row in datatable}
    actual = {}

    if "inline_keyboard" in markup:
        for row in markup["inline_keyboard"]:
            for btn in row:
                actual[btn.get("callback_data", btn.get("text", ""))] = btn.get("text", "")

    for btn_id, btn_text in expected.items():
        assert btn_id in actual or btn_text in actual.values(), \
            f"Кнопка {btn_id} ({btn_text}) не найдена в {actual}"


